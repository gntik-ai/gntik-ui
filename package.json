{
  "name": "gntik-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @gntik-ai/docs dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "registry": "pnpm --filter @gntik-ai/gntik-ui-mcp registry",
    "registry:check": "pnpm --filter @gntik-ai/gntik-ui-mcp registry:check",
    "visual": "pnpm --filter @gntik-ai/docs visual",
    "visual:update": "pnpm --filter @gntik-ai/docs visual:update",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
