{
  "name": "@gntik-ai/sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "In-browser playground: edit TSX against the whole kit, preview live in three themes, share by URL.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4177",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@gntik-ai/blocks": "workspace:*",
    "@gntik-ai/charts": "workspace:*",
    "@gntik-ai/chat": "workspace:*",
    "@gntik-ai/editor": "workspace:*",
    "@gntik-ai/flow": "workspace:*",
    "@gntik-ai/icons": "workspace:*",
    "@gntik-ai/templates": "workspace:*",
    "@gntik-ai/tokens": "workspace:*",
    "@gntik-ai/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0"
  }
}
