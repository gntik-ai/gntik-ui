{
  "name": "@gntik-ai/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-monaco.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-monaco.mjs",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "node --test test/block-labels.test.mjs test/block-labels.client.test.mjs test/select-listbox-normalization.test.mjs test/docs-coverage.test.mjs test/preview-catalog.test.mjs test/foundations-build.test.mjs test/forced-colors-css.test.mjs test/focus-ring-css.test.mjs",
    "visual": "playwright test catalog.visual",
    "visual:update": "playwright test catalog.visual --update-snapshots=changed",
    "a11y": "playwright test a11y",
    "test:yaml-worker": "node scripts/check-yaml-worker.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@gntik-ai/tokens": "workspace:*",
    "@xyflow/react": "^12.11.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@gntik-ai/blocks-baseline": "npm:@gntik-ai/blocks@0.5.0",
    "@gntik-ai/ui-baseline": "npm:@gntik-ai/ui@0.5.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "monaco-yaml": "^5.4.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
