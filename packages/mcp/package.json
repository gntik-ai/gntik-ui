{
  "name": "@gntik-ai/gntik-ui-mcp",
  "version": "0.1.0",
  "description": "MCP server del design system gntik-ui — remaquetación asistida desde Claude Code",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gntik-ui-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts --stdio",
    "dev:http": "tsx src/index.ts --http",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "registry": "tsc -p tsconfig.json && node dist/build-registry.js",
    "registry:check": "tsc -p tsconfig.json && node dist/build-registry.js --check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gntik-ai/gntik-ui.git",
    "directory": "packages/mcp"
  }
}
