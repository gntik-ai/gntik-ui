{
  "name": "@gntik-ai/evals",
  "version": "0.0.0",
  "private": true,
  "description": "Agent evaluations: a prompt battery run against the kit through its MCP tools; scores component choice, brand rules, kit-only imports and typechecking.",
  "type": "module",
  "scripts": {
    "eval": "tsx src/run.ts",
    "eval:dry": "tsx src/run.ts --dry-run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@gntik-ai/gntik-ui-mcp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
